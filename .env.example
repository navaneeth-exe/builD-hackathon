# ParkSync — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored and will NOT be committed.

# -------------------------------------------------------
# Supabase (required for the app to run)
# Find these in: https://supabase.com/dashboard -> Project Settings -> API
# -------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# -------------------------------------------------------
# AI Provider Keys (used by the Supabase Edge Function only)
# These are NOT exposed to the browser (no VITE_ prefix).
# Set these as Supabase Secrets:
#   supabase secrets set GEMINI_API_KEY="..."
#   supabase secrets set GROQ_API_KEY="..."
#
# The values below are only needed if running the edge function locally
# via: supabase functions serve
# -------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
